JWT_SECRET=
JWT_ISSUER=lmsPortalBe
JWT_AUDIENCE=lmsPortalBe-client
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

ConnectionStrings__DefaultConnection=Data Source=lmsPortalBe.db;Foreign Keys=True

# Comma-separated list of allowed CORS origins. Overrides Cors:AllowedOrigins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Admin user is seeded on startup only when username, email and password are set.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# Vercel Blob storage for interactive image uploads (https://vercel.com/docs/vercel-blob).
# Required only when uploading interactive images; the app boots without it.
BLOB_READ_WRITE_TOKEN=
# Optional: the store id is normally derived from the read-write token. Set this
# only if you want to override it.
BLOB_STORE_ID=
